# Database
DATABASE_URL="sqlite:///./mediscribe.db"
DIRECT_URL=""

# ─── AI Provider (Ollama — FREE, runs locally) ───────────────────────
# Install: https://ollama.com
# Recommended small model for local EMR testing:
#   ollama pull qwen2.5:0.5b
# If Ollama is still too slow, the API returns structured fast-regex fallback output.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:0.5b"
OLLAMA_TIMEOUT_SECS="8"
OLLAMA_NUM_PREDICT="160"
OLLAMA_PROMPT_PROFILE="compact"
EMR_MAX_RETRIES="0"
EMR_RETRY_DELAY_SECS="1.0"
ENABLE_OPENAI_FALLBACK="false"
OPENAI_EMR_MODEL="gpt-4o-mini"
OPENAI_TIMEOUT_SECS="20"
ENABLE_BLACKBOX_FALLBACK="false"
BLACKBOX_BASE_URL="https://api.blackbox.ai"
BLACKBOX_EMR_MODEL="blackboxai/openai/gpt-4"
BLACKBOX_TIMEOUT_SECS="20"
ENABLE_ANTHROPIC_FALLBACK="false"
ANTHROPIC_TIMEOUT_SECS="20"

# ─── Speech-to-Text: NVIDIA Riva/NIM Whisper API ─────────────────────
# Required for microphone transcription and audio file uploads
# Get your API key at: https://build.nvidia.com/
NVIDIA_API_KEY=""

# NVIDIA NIM Function ID for Whisper large v3 (pre-configured)
NVIDIA_FUNCTION_ID="b702f636-f60c-4a3d-a6f4-f3568c13bd7d"

# NVIDIA Riva gRPC server endpoint (pre-configured for NVCF)
NVIDIA_SERVER_URI="grpc.nvcf.nvidia.com:443"

# ─── Translation: NVIDIA Riva Translate 4B Instruct v2 ─────────────────
# Uses same NVIDIA_API_KEY as ASR
# Model: nvidia/riva-translate-4b-instruct-v2
# Supports 37 languages including en-hi (English to Hindi)
RIVA_TRANSLATE_MODEL="nvidia/riva-translate-4b-instruct-v2"
RIVA_TRANSLATE_URL="https://integrate.api.nvidia.com/v1"
ENABLE_RIVA_TRANSLATE="true"
RIVA_TRANSLATE_TIMEOUT="30.0"
RIVA_TRANSLATE_MAX_TOKENS="512"
RIVA_TRANSLATE_TEMPERATURE="0.0"

# ─── Optional: Groq Whisper API (fallback) ───────────────────────────
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=""

# ─── Optional: OpenAI API (alternative for Whisper) ──────────────────
OPENAI_API_KEY=""

# ─── Optional: Blackbox API (chat completions fallback) ───────────────
BLACKBOX_API_KEY="sk-your-blackbox-key-here"

# ─── Optional: Anthropic API (paid EMR fallback) ─────────────────────
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key-here"

# ─── Sarvam AI (for Indian language transcription) ───────────────────
SARVAM_API_KEY="your-sarvam-key-here"

# ─── ABDM (India Health Stack - ABHA ID) ─────────────────────────────
ABDM_CLIENT_ID="your-abdm-client-id"
ABDM_CLIENT_SECRET="your-abdm-client-secret"
ABDM_BASE_URL="https://healthidsbx.abdm.gov.in/api"

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# QR Code Security
QR_SECRET_KEY="dev-secret-key-min-32-chars-long123456"
